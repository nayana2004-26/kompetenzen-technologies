{
  "name": "kompetenzen-technologies",
  "version": "1.0.0",
  "private": true,
  "description": "Kompetenzen Technologies student pathway and program management demo",
  "main": "server/index.cjs",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server/index.cjs",
    "client:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.cjs",
    "check": "node --check server/index.cjs"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
